# RiskPulse — environment configuration.
# Copy to .env and adjust as needed. Every backend setting has a sane
# local default (see backend/app/config.py), so .env is optional for
# `uvicorn app.main:app` on a laptop — it becomes required once you run
# `docker compose up`, where these values wire the containers together.

# --- Backend: database ---
# Local dev default (backend/app/config.py): sqlite:///./riskpulse.db
# docker-compose default (see docker-compose.yml): real Postgres.
DATABASE_URL=postgresql+psycopg2://riskpulse:riskpulse@postgres:5432/riskpulse

# --- Backend: feature store ---
# Unset -> in-process/fakeredis fallback (no real Redis needed for local dev).
# docker-compose sets this to the real Redis service.
REDIS_URL=redis://redis:6379/0

# --- Backend: trained model artifacts ---
# Defaults to backend/models relative to the backend app; override only if
# artifacts live somewhere else (e.g. a mounted volume in production).
MODEL_DIR=/app/models

# --- Backend: JWT auth (demo credential; there's no real user system yet) ---
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60
DEMO_USERNAME=demo_admin
DEMO_PASSWORD=riskpulse-demo

# --- Backend: adaptive verification default thresholds ---
# (Live values are configurable at runtime via POST /api/v1/admin/thresholds
# and persisted to the DB — these are only the cold-start defaults.)
DEFAULT_APPROVE_THRESHOLD=0.30
DEFAULT_BLOCK_THRESHOLD=0.70
DEFAULT_PUPPET_THRESHOLD=0.70

# --- Backend: CORS ---
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# --- Postgres (docker-compose service) ---
POSTGRES_USER=riskpulse
POSTGRES_PASSWORD=riskpulse
POSTGRES_DB=riskpulse

# --- Frontend (Vite) ---
# Base URL the frontend calls for the real scoring API. Falls back to
# simulated/mock behavior automatically if this backend is unreachable.
VITE_API_BASE_URL=http://localhost:8000
